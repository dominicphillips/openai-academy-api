{
  "schemaVersion": 1,
  "serialization": "camelCase; all documented nullable fields are present",
  "routes": {
    "GET /v1/resources": {
      "query": {"q": "optional text, max 200 characters", "category": "optional category ID", "kind": "optional resource kind", "audience": "optional audience value", "cursor": "optional opaque cursor", "limit": "integer 1..100, default 20"},
      "response": {"items": ["Resource"], "nextCursor": null, "total": 0, "snapshotId": "sha256"},
      "ordering": "ascending stable resource ID",
      "errors": {"400": "invalid cursor or cursor/filter mismatch", "409": "cursor belongs to a different snapshot", "422": "invalid query value", "503": "no valid snapshot"}
    },
    "GET /v1/resources/{id}": {"response": "Resource", "errors": {"404": "unknown ID", "503": "no valid snapshot"}},
    "GET /v1/categories": {"response": {"items": [{"id": "category ID", "label": "source-backed label", "count": 0}], "snapshotId": "sha256"}},
    "GET /v1/status": {"response": {"state": "fresh|stale|unavailable", "snapshotId": null, "generatedAt": null, "lastAttemptAt": null, "lastSuccessAt": null, "resourceCount": 0, "coverage": []}},
    "GET /health": {"response": {"status": "ok"}},
    "GET /health/ready": {"response": {"status": "ready|unavailable"}},
    "GET /openapi.json": {"response": "OpenAPI 3.1 document"},
    "GET /docs": {"response": "Swagger UI"}
  },
  "Resource": {
    "id": "oa_ plus first 24 lowercase hex characters of SHA-256 of canonical URL",
    "title": "official title",
    "url": "canonical https://academy.openai.com public destination",
    "kind": "course|learning-path|article|video|event|collection|external",
    "categoryIds": [],
    "audiences": [],
    "tags": [],
    "summary": null,
    "level": null,
    "duration": {"courseMinutes": null, "pathMinutes": null, "videoSeconds": null},
    "detail": {
      "audience": null,
      "prerequisites": [],
      "objectives": [],
      "sections": [{"title": null, "context": null, "units": [{"title": "official unit title", "url": "official public destination", "kind": "lesson|quiz|course", "context": null, "videoCount": null}]}]
    },
    "media": [],
    "provenance": {"sourceUrls": ["official source URL"], "fetchedAt": "UTC ISO 8601", "contentHash": "SHA-256 of normalized resource metadata", "method": "managed-agent|manual|fixture"}
  },
  "MediaReference": {"kind": "video|audio|image|document", "url": "permitted external reference only", "permission": "permitted", "permissionEvidenceUrl": "official page establishing permission", "title": null},
  "Category": {"id": "lowercase slug", "label": "source-backed label"},
  "Coverage": {"categoryId": "category ID", "state": "complete|partial|not-collected", "discovered": null, "collected": 0},
  "audienceValues": ["general", "knowledge-workers", "developers", "leaders", "educators", "students", "admins", "other"],
  "levelValues": ["beginner", "intermediate", "advanced", null],
  "snapshotBehavior": "Public requests only read a validated local snapshot. They never crawl, run agents or spend. Failed refresh keeps the last valid snapshot. Age greater than 7 days reports stale by default.",
  "staticServing": "Optional --frontend-dir. API routes are registered first. Fingerprinted assets are immutable; index/documents are no-cache. SPA fallback never handles /v1, /health, /openapi.json or API documentation routes."
}
